{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Redis Cache Hit Rate (幂等锁命中率)",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(banking_redis_idempotency_hit_total[5m])) / clamp_min(sum(rate(banking_redis_idempotency_hit_total[5m])) + sum(rate(banking_redis_idempotency_miss_total[5m])), 0.001) * 100",
          "legendFormat": "幂等命中率 %",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Kafka Consumer Lag (消费积压延迟)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          },
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "max by (consumergroup, topic) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Successful Transfers",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "sum(transfer_success_total)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Failed Transfers",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "sum(transfer_failure_total)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Transfer Throughput",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "rate(transfer_success_total[5m])",
          "legendFormat": "success/s",
          "refId": "A"
        },
        {
          "expr": "rate(transfer_failure_total[5m])",
          "legendFormat": "failure/s",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Transfer Processing Latency",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "rate(transfer_duration_seconds_sum[5m]) / rate(transfer_duration_seconds_count[5m])",
          "legendFormat": "average latency",
          "refId": "A"
        }
      ]
    }
  ],
