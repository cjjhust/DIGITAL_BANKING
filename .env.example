# Example environment variables (do NOT commit real secrets)
# Copy to .env and fill in real values, .env is gitignored

# JWT secret (at least 256-bit random string)
APP_JWT_SECRET=change-me-to-a-very-long-random-secret
APP_JWT_EXPIRATION_MS=3600000

# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=banking_db

# Redis
REDIS_HOST=cache
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
