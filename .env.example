# Example environment variables (do NOT commit real secrets)
# Copy to .env and fill in real values, .env is gitignored
#
# 首次启动前必须配置下面这些值，否则应用会 fail-fast 拒绝启动：
#   APP_JWT_SECRET              —— JWT 签名密钥（≥32 字节；<64 字节只能用 HS256）
#   APP_DEFAULT_ADMIN_PASSWORD  —— 首个管理员口令（不再提供 admin123 默认值）
#   REDIS_PASSWORD              —— Redis 密码（compose 用 --requirepass 启动）
#   GRAFANA_ADMIN_PASSWORD      —— Grafana 管理员口令（不再硬编码 admin/admin）

# JWT secret (at least 256-bit random string)
APP_JWT_SECRET=change-me-to-a-very-long-random-secret-change-me
APP_JWT_EXPIRATION_MS=3600000

# 默认管理员（仅在库里没有 ADMIN 时创建）
APP_DEFAULT_ADMIN_PASSWORD=change-me-strong-admin-password

# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=banking_db

# Redis
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# 手机推送（ntfy）：手机装 ntfy App 后订阅这个 topic 即可
# 生成随机 topic：python3 -c "import secrets;print('banking-alert-'+secrets.token_hex(8))"
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=banking-alert-CHANGE_ME_TO_RANDOM
